# Local development only. Production never reads a file like this: the apply
# engine resolves secrets from AWS SSM and writes /etc/alert-platform/<svc>.env
# on the host at deploy time.
#
# To run a service locally:
#   cp .env.example .env && edit
#   set -a && . ./.env && set +a
#   PYTHONPATH=services python3 services/clinical_trials/main.py
#
# See docs/runbooks/local-development.md.

# --- platform contract (normally rendered by alertctl) ---
ALERT_SERVICE_NAME=clinical-trials
ALERT_SERVICE_TIER=standard
ALERT_STATE_DIR=./.local-state/clinical-trials
ALERT_LOG_LEVEL=INFO
ALERT_LOG_FORMAT=text
ALERT_POLL_INTERVAL_SEC=300
ALERT_SOURCE_URL=https://clinicaltrials.gov/api/v2/studies
ALERT_HEARTBEAT_INTERVAL_SEC=300
ALERT_STARTUP_GRACE_SEC=60
ALERT_METRICS_ENABLED=true
ALERT_METRICS_PORT=9103
ALERT_RATE_LIMIT_PER_MIN=10
ALERT_DEDUP_RETENTION_DAYS=365
ALERT_DEPLOYED_REF=local

# --- secrets (names match spec.delivery / spec.polling references) ---
ALERT_SECRET_TG_BOT_TOKEN=
ALERT_SECRET_TG_CHAT_TRIALS=
ALERT_SECRET_EDGAR_USER_AGENT=alert-platform you@example.com
