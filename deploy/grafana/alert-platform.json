{
  "title": "market-alert-suite \u2014 alert platform",
  "uid": "alert-platform",
  "tags": [
    "alert-platform",
    "generated"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Services up",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(alert_up{job=\"alert-platform\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Alerts sent (24h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(alert_alerts_sent_total[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Delivery failures (24h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(alert_delivery_failures_total[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Poll errors (1h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(alert_poll_errors_total[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heartbeat age by service",
      "description": "Rising line = the poll loop has stopped advancing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "time() - alert_heartbeat_timestamp_seconds",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Poll duration by service",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "alert_last_poll_duration_seconds",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Alerts sent per hour",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (service) (increase(alert_alerts_sent_total[1h]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Items examined per hour",
      "description": "Throughput. A flat line with a healthy heartbeat means the upstream went quiet, not that the service died.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (service) (increase(alert_items_seen_total[1h]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Deployed version by service",
      "description": "The `ref` label comes from the deploy, so this answers 'what is running?' without SSH.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "alert_up",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ],
  "description": "Generated by tools/gen_observability.py from fleet/services/*.yaml. Edit the specs, not this file."
}
